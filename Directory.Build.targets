<Project>
	<!--
	  Platform file convention for multi-targeted projects (net10.0 + net10.0-windows):
	    *.Windows.cs        code that needs WPF/WinForms types; compiled only for the Windows TFM.
	    *.CrossPlatform.cs  net10.0 counterparts; compiled only for the cross-platform TFM.
	    *.xaml.cs           WPF code-behind (Avalonia uses *.axaml.cs); compiled only for the Windows TFM.
	  Win32/registry code that compiles everywhere stays in shared files, marked [SupportedOSPlatform("windows")].
	-->
	<ItemGroup Condition="'$(TargetFramework)' != '' and !$(TargetFramework.Contains('-windows'))">
		<Compile Remove="**\*.Windows.cs;**\*.xaml.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
		<Compile Remove="**\*.CrossPlatform.cs" />
	</ItemGroup>

	<Target Name="ExcludePluginProjectReferenceOutput"
			AfterTargets="AssignProjectConfiguration" 
			BeforeTargets="ResolveProjectReferences" 
			Condition="'$(OutputType)' == 'Library' and '$(CopyLocalLockFileAssemblies)' == 'true' and $(AssemblyName.EndsWith('Tests')) == 'false' ">
	  <ItemGroup>
		<ProjectReferenceWithConfiguration Update="@(ProjectReferenceWithConfiguration)" >
		  <Private>false</Private>
		</ProjectReferenceWithConfiguration>
		<ProjectReference Update="@(ProjectReference)" >
		  <Private>false</Private>
		</ProjectReference>
	  </ItemGroup>
	</Target>

	<!-- Some native NuGet packages (e.g. SkiaSharp/HarfBuzzSharp 3.x) ship .pdb files next to their native
	     binaries (~100 MB per architecture); never copy them into build or publish output.
	     RuntimeTargetsCopyLocalItems: RID-less build; NativeCopyLocalItems: RID-specific publish. -->
	<Target Name="RemoveNativePackagePdbs" AfterTargets="ResolvePackageAssets">
	  <ItemGroup>
		<RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
		<NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
	  </ItemGroup>
	</Target>
</Project>