<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i18n="using:Flow.Launcher.Avalonia.Resource"
        mc:Ignorable="d"
        d:DesignWidth="520"
        d:DesignHeight="320"
        xmlns:views="using:Flow.Launcher.Avalonia.Views.SettingPages"
        x:Class="Flow.Launcher.Avalonia.Views.SettingPages.CustomShortcutWindow"
        x:DataType="views:CustomShortcutWindow"
        Title="{i18n:Localize customQueryShortcut}"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="16">
            <TextBlock Text="{i18n:Localize customQueryShortcut}"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <TextBlock Text="{i18n:Localize customShortcutDescription, Fallback='Create a reusable shortcut that expands into longer text inside the query box.'}"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize customShortcut}" />
                <TextBox x:Name="ShortcutKeyTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding ShortcutKey, Mode=TwoWay}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize customShortcutExpansion}" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Text="{Binding ShortcutValue, Mode=TwoWay}" />
                    <Button Grid.Column="1"
                            Content="{i18n:Localize preview}"
                            Click="OnPreviewClick" />
                </Grid>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Content="{i18n:Localize cancel}" Click="OnCancelClick" />
            <Button Content="{Binding ConfirmButtonText}"
                    Classes="accent"
                    Click="OnDoneClick" />
        </StackPanel>
    </Grid>
</Window>
