<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:i18n="using:Flow.Launcher.Avalonia.Resource"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Flow.Launcher.Avalonia.Views.SettingPages.SettingsWindow"
        Title="{i18n:Localize settingsWindowTitle, Fallback='Flow Launcher Settings'}"
        Width="900" Height="650"
        WindowStartupLocation="CenterScreen">

    <ui:FANavigationView Name="NavView"
                      PaneDisplayMode="Left"
                      OpenPaneLength="200"
                      IsSettingsVisible="False">
        <ui:FANavigationView.MenuItems>
            <ui:FANavigationViewItem Content="{i18n:Localize general}" Tag="General" IconSource="Setting" IsSelected="True" />
            <ui:FANavigationViewItem Content="{i18n:Localize plugin}" Tag="Plugins" IconSource="Library" />
            <ui:FANavigationViewItem Content="{i18n:Localize pluginStore}" Tag="PluginStore" IconSource="Shop" />
            <ui:FANavigationViewItem Content="{i18n:Localize theme}" Tag="Theme" IconSource="DarkTheme" />
            <ui:FANavigationViewItem Content="{i18n:Localize hotkey}" Tag="Hotkey" IconSource="Keyboard" />
            <ui:FANavigationViewItem Content="{i18n:Localize proxy}" Tag="Proxy" IconSource="Globe" />
            <ui:FANavigationViewItem Content="{i18n:Localize about}" Tag="About" IconSource="Help" />
        </ui:FANavigationView.MenuItems>

        <!-- Pages scroll themselves; an outer ScrollViewer would give them infinite height and defeat virtualization. -->
        <Panel Name="ContentFrame" Margin="20" />
    </ui:FANavigationView>
</Window>
