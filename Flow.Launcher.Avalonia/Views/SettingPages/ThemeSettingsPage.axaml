<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Flow.Launcher.Avalonia.ViewModel.SettingPages"
             xmlns:i18n="using:Flow.Launcher.Avalonia.Resource"
             xmlns:shared="using:Flow.Launcher.Plugin.SharedModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1200"
             x:Class="Flow.Launcher.Avalonia.Views.SettingPages.ThemeSettingsPage"
             x:DataType="vm:ThemeSettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="4" Margin="0,0,16,24">
            <TextBlock Text="{i18n:Localize appearance}" Classes="pageTitle" Margin="0,0,0,12" />

            <!-- Theme preview: a mock of the launcher window drawn with the same resources as MainWindow -->
            <Border Margin="0,0,0,12"
                    Padding="18"
                    Background="{DynamicResource ThemePreviewOuterBrush}"
                    CornerRadius="10">
                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        BorderThickness="{DynamicResource WindowBorderThickness}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        ClipToBounds="True">
                    <StackPanel>
                        <Border MinHeight="{Binding WindowHeightSize}"
                                Background="{DynamicResource QuerySurfaceBrush}"
                                Padding="16,8">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="Hello there"
                                           IsVisible="{Binding !ShowPlaceholder}"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding QueryBoxFontSize}"
                                           FontFamily="{Binding QueryFont}"
                                           FontWeight="{Binding QueryFontWeight}"
                                           FontStyle="{Binding QueryFontStyle}"
                                           Foreground="{DynamicResource QueryBoxForegroundBrush}" />
                                <TextBlock Text="{Binding PreviewPlaceholderText}"
                                           IsVisible="{Binding ShowPlaceholder}"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding QueryBoxFontSize}"
                                           FontFamily="{Binding QueryFont}"
                                           FontWeight="{Binding QueryFontWeight}"
                                           FontStyle="{Binding QueryFontStyle}"
                                           Foreground="{DynamicResource QuerySuggestionForegroundBrush}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClockText}"
                                               IsVisible="{Binding UseClock}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource QuerySuggestionForegroundBrush}" />
                                    <TextBlock Text="{Binding DateText}"
                                               IsVisible="{Binding UseDate}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource QuerySuggestionForegroundBrush}" />
                                </StackPanel>
                                <Path Grid.Column="2"
                                      Width="24"
                                      Height="24"
                                      Margin="8,0,2,0"
                                      Stretch="Uniform"
                                      Data="{DynamicResource SearchIconGeometry}"
                                      Fill="{DynamicResource SearchIconBrush}" />
                            </Grid>
                        </Border>
                        <Rectangle Height="1" Margin="12,0,12,0" Fill="{DynamicResource SeparatorBrush}" />
                        <StackPanel Margin="4,6,4,6" Spacing="2">
                            <Border MinHeight="{Binding ItemHeightSize}"
                                    Background="{DynamicResource SelectedItemBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Panel Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Globe" FontSize="28" Foreground="{DynamicResource ResultGlyphSelectedBrush}" />
                                        <ui:FASymbolIcon Symbol="Library"
                                                         FontSize="12"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         IsVisible="{Binding ShowBadges}"
                                                         Foreground="{DynamicResource ResultGlyphSelectedBrush}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sample result title"
                                                   FontSize="{Binding ResultItemFontSize}"
                                                   FontFamily="{Binding ResultFont}"
                                                   FontWeight="{Binding ResultFontWeight}"
                                                   FontStyle="{Binding ResultFontStyle}"
                                                   Foreground="{DynamicResource ResultTitleSelectedBrush}" />
                                        <TextBlock Text="Sample result subtitle"
                                                   FontSize="{Binding ResultSubItemFontSize}"
                                                   FontFamily="{Binding ResultSubFont}"
                                                   FontWeight="{Binding ResultSubFontWeight}"
                                                   FontStyle="{Binding ResultSubFontStyle}"
                                                   Foreground="{DynamicResource ResultSubTitleSelectedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border MinHeight="{Binding ItemHeightSize}"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Panel Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Folder" FontSize="28" Foreground="{DynamicResource ResultGlyphBrush}" />
                                        <ui:FASymbolIcon Symbol="Library"
                                                         FontSize="12"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         IsVisible="{Binding ShowBadges}"
                                                         Foreground="{DynamicResource ResultGlyphBrush}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sample result title"
                                                   FontSize="{Binding ResultItemFontSize}"
                                                   FontFamily="{Binding ResultFont}"
                                                   FontWeight="{Binding ResultFontWeight}"
                                                   FontStyle="{Binding ResultFontStyle}"
                                                   Foreground="{DynamicResource ResultTitleBrush}" />
                                        <TextBlock Text="Sample result subtitle"
                                                   FontSize="{Binding ResultSubItemFontSize}"
                                                   FontFamily="{Binding ResultSubFont}"
                                                   FontWeight="{Binding ResultSubFontWeight}"
                                                   FontStyle="{Binding ResultSubFontStyle}"
                                                   Foreground="{DynamicResource ResultSubTitleBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <ui:FASettingsExpander Header="{i18n:Localize theme}"
                                IconSource="DarkTheme"
                                IsExpanded="False">
                <ui:FASettingsExpander.Footer>
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="shared:ThemeData">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ui:FASymbolIcon Symbol="DarkTheme"
                                                     FontSize="14"
                                                     ToolTip.Tip="{i18n:Localize TypeIsDarkToolTip}"
                                                     IsVisible="{Binding IsDark, TargetNullValue=False, FallbackValue=False}" />
                                    <ui:FASymbolIcon Symbol="Drop"
                                                     FontSize="14"
                                                     ToolTip.Tip="{i18n:Localize TypeHasBlurToolTip}"
                                                     IsVisible="{Binding HasBlur, TargetNullValue=False, FallbackValue=False}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize ColorScheme}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding ColorSchemeOptions}"
                                  SelectedValue="{Binding SelectedColorScheme, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  DisplayMemberBinding="{Binding Display}"
                                  MinWidth="160" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize BackdropType}"
                                         Description="{Binding BackdropSubText}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding BackdropTypesList}"
                                  SelectedValue="{Binding SelectedBackdropType, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  DisplayMemberBinding="{Binding Display}"
                                  MinWidth="160"
                                  IsEnabled="{Binding IsBackdropEnabled}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize queryWindowShadowEffect}"
                                         Description="{i18n:Localize shadowEffectCPUUsage}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding DropShadowEffect}"
                                      IsEnabled="{Binding IsDropShadowEnabled}"
                                      ToolTip.Tip="{i18n:Localize shadowEffectNotAllowed}"
                                      ToolTip.IsEnabled="{Binding !IsDropShadowEnabled}"
                                      ToolTip.ShowOnDisabled="True" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Theme resources">
                    <ui:FASettingsExpanderItem.Footer>
                        <WrapPanel Orientation="Horizontal">
                            <Button Margin="0,0,8,8" Content="{i18n:Localize browserMoreThemes}" Command="{Binding OpenThemeGalleryCommand}" />
                            <Button Margin="0,0,8,8" Content="Theme Builder" Command="{Binding OpenThemeBuilderCommand}" />
                            <Button Margin="0,0,8,8" Content="{i18n:Localize settingfolder}" Command="{Binding OpenThemesFolderCommand}" />
                        </WrapPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{i18n:Localize KeepMaxResults}"
                                Description="{i18n:Localize KeepMaxResultsToolTip}"
                                IconSource="List"
                                IsExpanded="False">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding KeepMaxResults}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize maxShowResults}"
                                         Description="{i18n:Localize maxShowResultsToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding MaxResultsRange}"
                                  SelectedItem="{Binding MaxResults, Mode=TwoWay}"
                                  Width="100" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Sizing and fonts"
                                IconSource="Font"
                                IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{i18n:Localize SearchBarHeight}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding WindowHeightSize}" Width="40" VerticalAlignment="Center" />
                            <Slider Minimum="20" Maximum="60" Value="{Binding WindowHeightSize}" Width="220" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize ItemHeight}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding ItemHeightSize}" Width="40" VerticalAlignment="Center" />
                            <Slider Minimum="30" Maximum="100" Value="{Binding ItemHeightSize}" Width="220" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize queryBoxFont}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding QueryBoxFontSize}" Width="40" VerticalAlignment="Center" />
                                <Slider Minimum="10" Maximum="60" Value="{Binding QueryBoxFontSize}" Width="220" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding QueryFont, Mode=TwoWay}"
                                      MinWidth="220" />
                            <ComboBox ItemsSource="{Binding QueryTypefaceOptions}"
                                      SelectedItem="{Binding SelectedQueryTypeface, Mode=TwoWay}"
                                      MinWidth="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize resultItemFont}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding ResultItemFontSize}" Width="40" VerticalAlignment="Center" />
                                <Slider Minimum="10" Maximum="80" Value="{Binding ResultItemFontSize}" Width="220" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding ResultFont, Mode=TwoWay}"
                                      MinWidth="220" />
                            <ComboBox ItemsSource="{Binding ResultTypefaceOptions}"
                                      SelectedItem="{Binding SelectedResultTypeface, Mode=TwoWay}"
                                      MinWidth="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize resultSubItemFont}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding ResultSubItemFontSize}" Width="40" VerticalAlignment="Center" />
                                <Slider Minimum="6" Maximum="60" Value="{Binding ResultSubItemFontSize}" Width="220" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding ResultSubFont, Mode=TwoWay}"
                                      MinWidth="220" />
                            <ComboBox ItemsSource="{Binding ResultSubTypefaceOptions}"
                                      SelectedItem="{Binding SelectedResultSubTypeface, Mode=TwoWay}"
                                      MinWidth="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Theme sizing">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{i18n:Localize ImportThemeSize}" Command="{Binding ImportSizingCommand}" />
                            <Button Content="{i18n:Localize resetCustomize}" Command="{Binding ResetSizingCommand}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{Binding ClockAndDateText}"
                                IconSource="Clock"
                                IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{i18n:Localize Clock}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding ClockText}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding TimeFormatList}"
                                      SelectedItem="{Binding TimeFormat, Mode=TwoWay}"
                                      MinWidth="170" />
                            <ToggleSwitch IsChecked="{Binding UseClock}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize Date}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding DateFormatList}"
                                      SelectedItem="{Binding DateFormat, Mode=TwoWay}"
                                      MinWidth="170" />
                            <ToggleSwitch IsChecked="{Binding UseDate}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{i18n:Localize ShowPlaceholder}"
                                Description="{i18n:Localize ShowPlaceholderTip}"
                                IconSource="Edit"
                                IsExpanded="False">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ShowPlaceholder}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize PlaceholderText}"
                                         Description="{Binding PlaceholderTextTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <TextBox Text="{Binding PlaceholderText, Mode=TwoWay}" MinWidth="220" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{i18n:Localize Animation}"
                                Description="{i18n:Localize AnimationTip}"
                                IconSource="Play"
                                IsExpanded="False">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding UseAnimation}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize AnimationSpeed}"
                                         Description="{i18n:Localize AnimationSpeedTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox ItemsSource="{Binding AnimationSpeedOptions}"
                                      SelectedValue="{Binding SelectedAnimationSpeed, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}"
                                      DisplayMemberBinding="{Binding Display}"
                                      MinWidth="160" />
                            <ui:FANumberBox Value="{Binding CustomAnimationLength}"
                                          Minimum="0"
                                          Maximum="2000"
                                          Width="100"
                                          IsVisible="{Binding IsCustomAnimationSpeed}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{i18n:Localize SoundEffect}"
                                Description="{i18n:Localize SoundEffectTip}"
                                IconSource="Audio"
                                IsExpanded="False">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding UseSound}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize SoundEffectVolume}"
                                         Description="{i18n:Localize SoundEffectVolumeTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SoundEffectVolume}" Width="40" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding SoundEffectVolume}" Width="220" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{i18n:Localize CodeHighlightTheme}"
                                Description="{i18n:Localize CodeHighlightThemeTooltip}"
                                IconSource="Code">
                <ui:FASettingsExpander.Footer>
                    <ComboBox ItemsSource="{Binding CodeHighlightThemeOptions}"
                              SelectedValue="{Binding SelectedCodeHighlightTheme, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Value}"
                              DisplayMemberBinding="{Binding Display}"
                              MinWidth="220" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{i18n:Localize useGlyphUI}"
                                Description="{i18n:Localize useGlyphUIEffect}"
                                IconSource="Font"
                                IsExpanded="False">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding UseGlyphIcons}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize showBadges}"
                                         Description="{i18n:Localize showBadgesToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ShowBadges}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{i18n:Localize showBadgesGlobalOnly}"
                                         Description="{i18n:Localize showBadgesGlobalOnlyToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ShowBadgesGlobalOnly}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
