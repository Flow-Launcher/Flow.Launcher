<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Flow.Launcher.Avalonia.ViewModel.SettingPages"
             xmlns:i18n="using:Flow.Launcher.Avalonia.Resource"
             xmlns:controls="using:Flow.Launcher.Avalonia.Views.Controls"
             xmlns:userSettings="using:Flow.Launcher.Infrastructure.UserSettings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1200"
             x:Class="Flow.Launcher.Avalonia.Views.SettingPages.HotkeySettingsPage"
             x:DataType="vm:HotkeySettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="4" Margin="0,0,16,24">
            <TextBlock Text="{i18n:Localize hotkey}" Classes="pageTitle" Margin="0,0,0,12" />

            <!-- Toggle Flow Launcher Hotkey -->
            <ui:FASettingsExpander Header="{i18n:Localize flowlauncherHotkey}"
                                Description="{i18n:Localize flowlauncherHotkeyToolTip}"
                                IconSource="Keyboard">
                <ui:FASettingsExpander.Footer>
                    <controls:HotkeyControl Hotkey="{Binding ToggleHotkey, Mode=TwoWay}"
                                            MinWidth="150"
                                            UnregisterToggleHotkeyWhileRecording="True" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Preview Hotkey -->
            <ui:FASettingsExpander Header="{i18n:Localize previewHotkey}"
                                Description="{i18n:Localize previewHotkeyToolTip}"
                                IconSource="View">
                <ui:FASettingsExpander.Footer>
                    <controls:HotkeyControl Hotkey="{Binding PreviewHotkey, Mode=TwoWay}" MinWidth="150" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Open Result Modifiers -->
            <ui:FASettingsExpander Header="{i18n:Localize openResultModifiers}"
                                Description="{i18n:Localize openResultModifiersToolTip}"
                                IconSource="Keyboard">
                <ui:FASettingsExpander.Footer>
                    <ComboBox Width="140"
                              ItemsSource="{Binding OpenResultModifiersList}"
                              SelectedItem="{Binding OpenResultModifiers}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize showOpenResultHotkey}"
                                         Description="{i18n:Localize showOpenResultHotkeyToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ShowOpenResultHotkey}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Dialog Jump Hotkey -->
            <ui:FASettingsExpander Header="{i18n:Localize dialogJumpHotkey}"
                                Description="{i18n:Localize dialogJumpHotkeyToolTip}"
                                IconSource="Target">
                <ui:FASettingsExpander.Footer>
                    <controls:HotkeyControl Hotkey="{Binding DialogJumpHotkey, Mode=TwoWay}" MinWidth="150" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Hotkey Presets (expandable group with fixed hotkeys) -->
            <ui:FASettingsExpander Header="{i18n:Localize hotkeyPresets}"
                                Description="{i18n:Localize hotkeyPresetsToolTip}"
                                IconSource="Keyboard"
                                IsExpanded="False">
                
                <!-- Open Containing Folder -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize OpenContainFolderHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Ctrl+Enter" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Run as Admin -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize RunAsAdminHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Ctrl+Shift+Enter" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Toggle History -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize ToggleHistoryHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding OpenHistoryHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Copy File Path -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize CopyFilePathHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Ctrl+Shift+C" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Open Context Menu (customizable) -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize OpenContextMenuHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding OpenContextMenuHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Open Context Menu (fixed Shift+Enter) -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize OpenContextMenuHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Shift+Enter" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Open Native Context Menu -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize OpenNativeContextMenuHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Alt+Enter" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Settings Window -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize SettingWindowHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding SettingWindowHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Toggle Game Mode -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize ToggleGameModeHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Ctrl+F12" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Requery -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize RequeryHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="Ctrl+R" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Cycle History Up -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize CycleHistoryUpHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding CycleHistoryUpHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Cycle History Down -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize CycleHistoryDownHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding CycleHistoryDownHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Reload Plugin -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize ReloadPluginHotkey}"
                                         Description="{i18n:Localize ReloadPluginHotkeyToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyDisplay Keys="F5" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Select Prev Page -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize SelectPrevPageHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding SelectPrevPageHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Select Next Page -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize SelectNextPageHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding SelectNextPageHotkey, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Quick Width -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize QuickWidthHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:HotkeyDisplay Keys="Ctrl+[" />
                            <controls:HotkeyDisplay Keys="Ctrl+]" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <!-- Quick Height -->
                <ui:FASettingsExpanderItem Content="{i18n:Localize QuickHeightHotkey}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:HotkeyDisplay Keys="Ctrl+Plus" />
                            <controls:HotkeyDisplay Keys="Ctrl+Minus" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Auto-complete Hotkey -->
            <ui:FASettingsExpander Header="{i18n:Localize autoCompleteHotkey}"
                                Description="{i18n:Localize autoCompleteHotkeyToolTip}"
                                IconSource="Accept">
                <ui:FASettingsExpander.Footer>
                    <controls:HotkeyControl Hotkey="{Binding AutoCompleteHotkey, Mode=TwoWay}" MinWidth="150" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize autoCompleteHotkey}"
                                         Description="{i18n:Localize AdditionalHotkeyToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding AutoCompleteHotkey2, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Select Previous Item -->
            <ui:FASettingsExpander Header="{i18n:Localize SelectPrevItemHotkey}"
                                IconSource="ChevronUp">
                <ui:FASettingsExpander.Footer>
                    <controls:HotkeyControl Hotkey="{Binding SelectPrevItemHotkey, Mode=TwoWay}" MinWidth="150" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize SelectPrevItemHotkey}"
                                         Description="{i18n:Localize AdditionalHotkeyToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding SelectPrevItemHotkey2, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Select Next Item -->
            <ui:FASettingsExpander Header="{i18n:Localize SelectNextItemHotkey}"
                                IconSource="ChevronDown">
                <ui:FASettingsExpander.Footer>
                    <controls:HotkeyControl Hotkey="{Binding SelectNextItemHotkey, Mode=TwoWay}" MinWidth="150" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{i18n:Localize SelectNextItemHotkey}"
                                         Description="{i18n:Localize AdditionalHotkeyToolTip}">
                    <ui:FASettingsExpanderItem.Footer>
                        <controls:HotkeyControl Hotkey="{Binding SelectNextItemHotkey2, Mode=TwoWay}" MinWidth="120" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Custom Query Hotkeys -->
            <ui:FASettingsExpander Header="{i18n:Localize customQueryHotkey}"
                                IconSource="Keyboard"
                                IsExpanded="False">
                <StackPanel Spacing="8" Margin="0,8">
                    <DataGrid ItemsSource="{Binding CustomPluginHotkeys}"
                              SelectedItem="{Binding SelectedCustomPluginHotkey}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              MinHeight="150"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{i18n:Localize hotkey}" 
                                               Binding="{Binding Hotkey}" 
                                               Width="180" />
                            <DataGridTextColumn Header="{i18n:Localize customQuery}" 
                                               Binding="{Binding ActionKeyword}" 
                                               Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{i18n:Localize delete}" 
                                Command="{Binding CustomHotkeyDeleteCommand}"
                                MinWidth="80" />
                        <Button Content="{i18n:Localize edit}" 
                                Command="{Binding CustomHotkeyEditCommand}"
                                MinWidth="80" />
                        <Button Content="{i18n:Localize add}" 
                                Command="{Binding CustomHotkeyAddCommand}"
                                MinWidth="80" />
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- Custom Shortcuts -->
            <ui:FASettingsExpander Header="{i18n:Localize customQueryShortcut}"
                                IconSource="Edit"
                                IsExpanded="False">
                <StackPanel Spacing="8" Margin="0,8">
                    <DataGrid ItemsSource="{Binding CustomShortcuts}"
                              SelectedItem="{Binding SelectedCustomShortcut}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              MinHeight="150"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{i18n:Localize customShortcut}" 
                                               Binding="{Binding Key}" 
                                               Width="180" />
                            <DataGridTextColumn Header="{i18n:Localize customShortcutExpansion}" 
                                               Binding="{Binding Value}" 
                                               Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{i18n:Localize delete}" 
                                Command="{Binding CustomShortcutDeleteCommand}"
                                MinWidth="80" />
                        <Button Content="{i18n:Localize edit}" 
                                Command="{Binding CustomShortcutEditCommand}"
                                MinWidth="80" />
                        <Button Content="{i18n:Localize add}" 
                                Command="{Binding CustomShortcutAddCommand}"
                                MinWidth="80" />
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- Builtin Shortcuts -->
            <ui:FASettingsExpander Header="{i18n:Localize builtinShortcuts}"
                                IconSource="Library"
                                IsExpanded="False">
                <DataGrid ItemsSource="{Binding BuiltinShortcuts}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          MinHeight="100"
                          MaxHeight="200"
                          Margin="0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{i18n:Localize customShortcut}" 
                                           Binding="{Binding Key}" 
                                           Width="180" />
                        <DataGridTextColumn Header="{i18n:Localize builtinShortcutDescription}" 
                                           Binding="{Binding LocalizedDescription}" 
                                           Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </ui:FASettingsExpander>

            <!-- Hotkey format tip -->
            <TextBlock Text="{i18n:Localize hotkeyFormatTip}" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       FontSize="12"
                       Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
