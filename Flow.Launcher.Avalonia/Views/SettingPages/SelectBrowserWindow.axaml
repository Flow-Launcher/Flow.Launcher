<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i18n="using:Flow.Launcher.Avalonia.Resource"
        xmlns:views="using:Flow.Launcher.Avalonia.Views.SettingPages"
        mc:Ignorable="d"
        d:DesignWidth="640"
        d:DesignHeight="520"
        x:Class="Flow.Launcher.Avalonia.Views.SettingPages.SelectBrowserWindow"
        x:DataType="views:SelectBrowserWindow"
        Title="{i18n:Localize defaultBrowser}"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="{i18n:Localize defaultBrowser}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{i18n:Localize defaultBrowser_tips}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize defaultBrowser_name}" />
                <ComboBox Grid.Column="1"
                           MinWidth="240"
                           Margin="0,0,10,0"
                           ItemsSource="{Binding CustomBrowsers}"
                           SelectedIndex="{Binding SelectedCustomBrowserIndex, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2"
                        Margin="0,0,10,0"
                        Content="{i18n:Localize add}"
                        Click="OnAddClick" />
                <Button Grid.Column="3"
                        Content="{i18n:Localize delete}"
                        IsEnabled="{Binding CurrentBrowser.Editable}"
                        Click="OnDeleteClick" />
            </Grid>

            <Separator />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize defaultBrowser_profile_name}" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,0,12"
                         Text="{Binding CurrentBrowser.Name, Mode=TwoWay}"
                         IsEnabled="{Binding CurrentBrowser.Editable}"
                         TextChanged="OnProfileTextChanged" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize defaultBrowser_path}" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Text="{Binding CurrentBrowser.Path, Mode=TwoWay}"
                             IsEnabled="{Binding CurrentBrowser.Editable}" />
                    <Button Grid.Column="1"
                            Content="{i18n:Localize select}"
                            IsEnabled="{Binding CurrentBrowser.Editable}"
                            Click="OnBrowseClick" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize defaultBrowser_newTab}" />
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,12"
                            Orientation="Horizontal"
                            Spacing="16">
                    <RadioButton Content="{i18n:Localize defaultBrowser_newTab}"
                                 GroupName="OpenMode"
                                 IsChecked="{Binding IsOpenInTab, Mode=TwoWay}" />
                    <RadioButton Content="{i18n:Localize defaultBrowser_newWindow}"
                                 GroupName="OpenMode"
                                 IsChecked="{Binding IsOpenInNewWindow, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize defaultBrowser_parameter}" />
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBox Grid.Column="0"
                             Margin="0,0,12,0"
                             Text="{Binding CurrentBrowser.PrivateArg, Mode=TwoWay}"
                             TextChanged="OnPrivateArgTextChanged" />
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding HasPrivateArg}"
                              IsChecked="{Binding CurrentBrowser.EnablePrivate, Mode=TwoWay}" />
                </Grid>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{i18n:Localize defaultBrowser_extraArgs}" />
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding CurrentBrowser.ExtraArgs, Mode=TwoWay}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Content="{i18n:Localize cancel}" Click="OnCancelClick" />
            <Button Content="{i18n:Localize done}"
                    Classes="accent"
                    Click="OnDoneClick" />
        </StackPanel>
    </Grid>
</Window>
