<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flow.Launcher.Avalonia.ViewModel"
             xmlns:helper="using:Flow.Launcher.Avalonia.Helper"
             xmlns:views="using:Flow.Launcher.Avalonia.Views"
             xmlns:converters="using:Flow.Launcher.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="300"
             x:Class="Flow.Launcher.Avalonia.Views.ResultListBox"
             x:DataType="vm:ResultsViewModel">

    <UserControl.Resources>
        <converters:OrdinalConverter x:Key="OrdinalConverter" />
        <converters:OpenResultHotkeyVisibilityConverter x:Key="OpenResultHotkeyVisibilityConverter" />
    </UserControl.Resources>

    <!-- Not focusable (like WPF): keyboard focus stays in the query box while the mouse selects/opens results. -->
    <ListBox Name="ResultsList"
             Classes="resultListBox"
             Focusable="False"
             ItemsSource="{Binding Results}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
             MaxHeight="{Binding MaxHeight}"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
         
        <!-- Enable virtualization for better performance -->
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultViewModel">
                <Grid Classes="resultItemGrid"
                      ColumnDefinitions="Auto,*,Auto"
                      MinHeight="{Binding Settings.ItemHeightSize}">
                    
                    <!-- Selection Bullet -->
                    <Border Grid.Column="0" 
                            Classes="resultBullet"
                            VerticalAlignment="Stretch" />
                    
                    <!-- Icon Area -->
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="6,0,0,0">
                        
                        <!-- Icon Container (fixed size for perfect centering) -->
                        <Panel Grid.Column="0" Width="32" Height="32" Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- Glyph Icon -->
                            <TextBlock Classes="resultGlyph"
                                       Text="{Binding Glyph.Glyph}"
                                       IsVisible="{Binding ShowGlyph}"
                                       FontFamily="{Binding GlyphFontFamily}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <!-- Image Icon (clipped to a circle for Result.RoundedIcon) -->
                            <Border CornerRadius="{Binding IconCornerRadius}"
                                    ClipToBounds="True"
                                    IsVisible="{Binding !ShowGlyph}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image Classes="resultIcon"
                                       Source="{Binding ListIcon^, FallbackValue={x:Static helper:ImageLoader.DefaultImage}}"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>

                            <!-- Plugin badge overlaying the bottom-right corner of the icon -->
                            <Image Width="19"
                                   Height="19"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,-4,-4"
                                   IsHitTestVisible="False"
                                   IsVisible="{Binding ShowBadge}"
                                   Source="{Binding BadgeImage^}"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Panel>

                        <!-- Title and SubTitle -->
                        <Grid Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              Margin="10,0,10,0"
                              VerticalAlignment="Center">

                            <!-- Result.ProgressBar (0-100) drawn behind the title -->
                            <ProgressBar Grid.Row="0"
                                         Height="18"
                                         MinHeight="18"
                                         MinWidth="0"
                                         Margin="0,0,0,4"
                                         VerticalAlignment="Center"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ResultProgress, Mode=OneWay}"
                                         Foreground="{Binding ProgressBarBrush}"
                                         IsVisible="{Binding ShowProgressBar}"
                                         IsHitTestVisible="False" />

                            <TextBlock Grid.Row="0"
                                       Classes="resultTitle"
                                       FontSize="{Binding Settings.ResultItemFontSize}"
                                       FontFamily="{Binding Settings.ResultFont}"
                                       FontWeight="{Binding TitleFontWeight}"
                                       FontStyle="{Binding TitleFontStyle}"
                                       FontStretch="{Binding TitleFontStretch}"
                                       ToolTip.Tip="{Binding TitleToolTip}"
                                       helper:TextBlockHelper.HighlightText="{Binding Title}"
                                       helper:TextBlockHelper.HighlightData="{Binding TitleHighlightData}" />

                            <TextBlock Grid.Row="1"
                                       Classes="resultSubTitle"
                                       FontSize="{Binding Settings.ResultSubItemFontSize}"
                                       FontFamily="{Binding Settings.ResultSubFont}"
                                       FontWeight="{Binding SubTitleFontWeight}"
                                       FontStyle="{Binding SubTitleFontStyle}"
                                       FontStretch="{Binding SubTitleFontStretch}"
                                       IsVisible="{Binding ShowSubTitle}"
                                       Text="{Binding SubTitle}"
                                       ToolTip.Tip="{Binding SubTitleToolTip}" />
                        </Grid>
                    </Grid>

                    <!-- Open-result hotkey (OpenResultModifiers+1 ... +0) for the first ten results -->
                    <Border Grid.Column="2"
                            Classes="hotkeyBadge"
                            VerticalAlignment="Center">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Settings.ShowOpenResultHotkey" FallbackValue="False" />
                                <Binding Path="$parent[ListBoxItem].(views:ResultListBox.ItemIndex)"
                                         Converter="{StaticResource OpenResultHotkeyVisibilityConverter}" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <TextBlock Classes="hotkeyText">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}+{1}">
                                    <Binding Path="Settings.OpenResultModifiers" />
                                    <Binding Path="$parent[ListBoxItem].(views:ResultListBox.ItemIndex)"
                                             Converter="{StaticResource OrdinalConverter}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
        
        <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="4,2,4,2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="Background" Value="Transparent" />
                
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{DynamicResource SelectedItemBackgroundBrush}" />
                </Style>
                
                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SelectedItemBackgroundBrush}" />
                </Style>
                
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource HoveredItemBackgroundBrush}" />
                </Style>

                <!-- FluentAvalonia's selection pill, colored by the theme's ItemBulletSelectedStyle (Helper/ThemeLoader.cs). -->
                <Style Selector="^ /template/ Rectangle#SelectionIndicator">
                    <Setter Property="Fill" Value="{DynamicResource ResultSelectionIndicatorBrush}" />
                </Style>
                <Style Selector="^:selected /template/ Rectangle#SelectionIndicator">
                    <Setter Property="Fill" Value="{DynamicResource ResultSelectionIndicatorBrush}" />
                </Style>
                <Style Selector="^:selected:pointerover /template/ Rectangle#SelectionIndicator">
                    <Setter Property="Fill" Value="{DynamicResource ResultSelectionIndicatorBrush}" />
                </Style>
                <Style Selector="^:selected:pressed /template/ Rectangle#SelectionIndicator">
                    <Setter Property="Fill" Value="{DynamicResource ResultSelectionIndicatorBrush}" />
                </Style>
            </ControlTheme>
        </ListBox.ItemContainerTheme>
        
    </ListBox>
</UserControl>
