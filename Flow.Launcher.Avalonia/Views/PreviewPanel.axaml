<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flow.Launcher.Avalonia.ViewModel"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="Flow.Launcher.Avalonia.Views.PreviewPanel"
             x:DataType="vm:ResultViewModel">

    <Panel>
        <!-- Default preview: Result.Preview image/description, markdown, or the result icon + title + subtitle -->
        <Grid RowDefinitions="*,Auto" Margin="16,16,16,12" IsVisible="{Binding ShowDefaultPreview, FallbackValue=False}">

            <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !IsMarkdownPreview}">
                <TextBlock Text="{Binding Glyph.Glyph}"
                           FontFamily="{Binding GlyphFontFamily}"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           IsVisible="{Binding ShowPreviewGlyph}" />

                <!-- Icon-sized thumbnail, or the full panel width for media (Result.Preview.IsMedia) -->
                <Image Source="{Binding PreviewImage^}"
                       MaxHeight="320"
                       MaxWidth="{Binding PreviewImageMaxWidth}"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsVisible="{Binding ShowPreviewImage}" />

                <SelectableTextBlock Text="{Binding Title}"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     Margin="0,0,0,10" />
            </StackPanel>

            <!-- Markdown description (Result.Preview.ContentType = Markdown), code blocks syntax-highlighted -->
            <md:MarkdownScrollViewer Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Markdown="{Binding PreviewMarkdown}"
                                     IsVisible="{Binding IsMarkdownPreview}" />

            <StackPanel Grid.Row="1" Spacing="8">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsMarkdownPreview" />
                        <Binding Path="ShowPreviewDescription" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">
                        <SelectableTextBlock Text="{Binding PreviewDescription}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding PreviewFilePath}"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding ShowPreviewFilePath}" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- Plugin-provided preview control (Result.PreviewPanel yielding an Avalonia Control) -->
        <ContentControl Margin="0,0,10,10"
                        Content="{Binding CustomPreviewControl}"
                        IsVisible="{Binding ShowCustomPreview, FallbackValue=False}" />
    </Panel>
</UserControl>
