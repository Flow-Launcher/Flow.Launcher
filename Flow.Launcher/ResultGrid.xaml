<UserControl
    x:Class="Flow.Launcher.ResultGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Flow.Launcher.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel}"
    mc:Ignorable="d">
    <ListBox
        x:Name="ResultListBox"
        Background="Transparent"
        BorderThickness="0"
        ItemsSource="{Binding Results}"
        KeyboardNavigation.DirectionalNavigation="Cycle"
        KeyboardNavigation.TabNavigation="Continue"
        PreviewMouseDown="ListBox_PreviewMouseDown"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="5" IsItemsHost="True" />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <EventSetter Event="MouseEnter" Handler="OnMouseEnter" />
                <EventSetter Event="MouseMove" Handler="OnMouseMove" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBorder"
                                Margin="0"
                                Padding="2"
                                Background="Transparent"
                                CornerRadius="4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemSelectedBackgroundColor}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ItemSelectedBackgroundColor}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                <StackPanel
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnItemClick"
                    ToolTip="{Binding ShowSubTitleToolTip}">
                    <Border
                        Width="42"
                        Height="42"
                        Margin="0 1 0 2"
                        HorizontalAlignment="Center"
                        CornerRadius="4">
                        <Grid>
                            <Image
                                Width="32"
                                Height="32"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding Image}"
                                Visibility="{Binding ShowIcon}" />
                            <TextBlock
                                Width="Auto"
                                Height="Auto"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{Binding Glyph.FontFamily}"
                                FontSize="24"
                                Style="{DynamicResource ItemGlyph}"
                                Text="{Binding Glyph.Glyph}"
                                Visibility="{Binding ShowGlyph}" />
                            <Image
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Source="{Binding BadgeImage}"
                                Visibility="{Binding ShowBadge}" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Margin="2 0 2 1"
                        HorizontalAlignment="Center"
                        FontSize="9"
                        Foreground="White"
                        Opacity="0.9"
                        Text="{Binding Result.Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ShowTitleToolTip}" />
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>