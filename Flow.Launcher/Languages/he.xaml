    <!--  Welcome Window  -->
    <system:String x:Key="Skip">דלג</system:String>
    <system:String x:Key="Welcome_Page1_Title">ברוכים הבאים ל-Flow Launcher</system:String>
    <system:String x:Key="Welcome_Page1_Text01">שלום, זו הפעם הראשונה שאתה מפעיל את Flow Launcher!</system:String>
    <system:String x:Key="Welcome_Page1_Text02">לפני שמתחילים, אשף זה יסייע לך בהגדרת Flow Launcher. באפשרותך לדלג על שלב זה אם תרצה בכך. אנא בחר שפה מועדפת</system:String>
    <system:String x:Key="Welcome_Page2_Title">חפש והפעל את כל הקבצים והאפליקציות במחשב שלך</system:String>
    <system:String x:Key="Welcome_Page2_Text01">חפש הכל - החל מאפליקציות, קבצים, סימניות, שירותי רשת ועוד. הכל בנוחות מלאה ישירות מהמקלדת, ללא צורך לגעת בעכבר.</system:String>
    <system:String x:Key="Welcome_Page2_Text02">Flow Launcher מופעל באמצעות מקש הקיצור שלהלן, נסה זאת כעת. כדי לשנות אותו, לחץ על שדה הקלט והקש על מקש הקיצור הרצוי במקלדת.</system:String>
    <system:String x:Key="Welcome_Page3_Title">מקשי קיצור</system:String>
    <system:String x:Key="Welcome_Page4_Title">מילות מפתח ופקודות לפעולה</system:String>
    <system:String x:Key="Welcome_Page4_Text01">חפש ברשת, הפעל אפליקציות או בצע פונקציות מגוונות באמצעות תוספי Flow Launcher. פונקציות מסוימות מתחילות במילת מפתח ייעודית, ובמידת הצורך, ניתן להשתמש בהן גם ללא מילת מפתח. נסה את השאילתות שלהלן ב-Flow Launcher.</system:String>
    <system:String x:Key="Welcome_Page5_Title">בוא נתחיל להשתמש ב-Flow Launcher</system:String>
    <system:String x:Key="Welcome_Page5_Text01">הסתיים בהצלחה. תהנה מ-Flow Launcher. אל תשכח את מקש הקיצור להפעלה :)</system:String>

